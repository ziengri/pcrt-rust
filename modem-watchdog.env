# Modem watchdog configuration.
# Watches a NetworkManager connection and resets the LTE USB modem via usbreset
# whenever the connection is not active.

# Set to 0 to disable the watchdog (service stays installed but idles).
MODEM_WATCHDOG_ENABLED=1

# NetworkManager connection name to watch (see: nmcli c).
MODEM_CONN_NAME=sim-internet

# USB device id (VID:PID) passed to usbreset (see: lsusb).
MODEM_USB_ID=12d1:15c1

# Poll interval, seconds, while the connection is healthy.
MODEM_CHECK_INTERVAL=30

# Wait time, seconds, after a reset before re-checking (5 minutes).
MODEM_RESET_WAIT=300
