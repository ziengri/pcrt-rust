# Native RS-232 door gateway configuration.
# SERIAL_PORT_FIND is used unless SERIAL_PORT is set to a specific device.
SERIAL_PORT=/dev/ttyS1
SERIAL_PORT_FIND=
SERIAL_BAUDRATE=19200
SERIAL_BYTESIZE=8
SERIAL_PARITY=N
SERIAL_STOPBITS=1
SERIAL_TIMEOUT=0.2
STALE_TIMEOUT_SEC=2
SERIAL_LIVENESS_TIMEOUT_SEC=15
HEARTBEAT_PUBLISH_SEC=0.5
RECONNECT_SEC=1
